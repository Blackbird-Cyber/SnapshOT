# SnapshOT Plymouth theme (script plugin).
# Ink background, the SnapshOT lockup centred, a short signal-red rule under it,
# and text prompts for the LUKS passphrase, questions, and boot messages.
# Palette: ink #0A0B0C, signal red #F1000E, light #F4F5F6.

Window.SetBackgroundTopColor(0.039, 0.043, 0.047);
Window.SetBackgroundBottomColor(0.039, 0.043, 0.047);

screen.x = Window.GetX();
screen.y = Window.GetY();
screen.w = Window.GetWidth();
screen.h = Window.GetHeight();

# ---- lockup: 38% of the screen width, a little above centre -----------------
lockup.src = Image("lockup.png");
lockup.w = Math.Int(screen.w * 0.38);
lockup.h = Math.Int(lockup.src.GetHeight() * lockup.w / lockup.src.GetWidth());
lockup.image = lockup.src.Scale(lockup.w, lockup.h);
lockup.sprite = Sprite(lockup.image);
lockup.x = screen.x + (screen.w - lockup.w) / 2;
lockup.y = screen.y + (screen.h - lockup.h) / 2 - lockup.h * 0.4;
lockup.sprite.SetPosition(lockup.x, lockup.y, 10);

# ---- signal-red rule under the lockup ---------------------------------------
rule.w = Math.Int(screen.w * 0.05);
rule.h = Math.Int(screen.h / 400) + 1;
rule.image = Image("rule.png").Scale(rule.w, rule.h);
rule.sprite = Sprite(rule.image);
rule.y = lockup.y + lockup.h + Math.Int(lockup.h * 0.5);
rule.sprite.SetPosition(screen.x + (screen.w - rule.w) / 2, rule.y, 10);

# ---- state kept on screen by the callbacks ----------------------------------
# A name first assigned inside a function is local to that call, and a sprite
# is taken off the screen when its last reference goes away. The callbacks
# therefore keep their sprites in these global hashes, created here at the top
# level; without them the prompt and the bullets vanished as each callback
# returned.
prompt.sprite = NULL;
answer.sprite = NULL;
message.sprite = NULL;
bullets.count = 0;

# ---- text rows --------------------------------------------------------------
# Image.Text yields an empty image when no label plugin or font can be loaded;
# fall back to a line height derived from the screen so the layout holds.
probe = Image.Text("Xg", 1, 1, 1);
if (probe && probe.GetHeight() > 0)
    text.line = Math.Int(probe.GetHeight() * 1.6);
else
    text.line = Math.Int(screen.h / 30) + 1;
text.y = rule.y + text.line * 2;

# ---- passphrase bullets: small signal-red squares cut from rule.png ---------
# Sprites, not text, so keystrokes show even when no font renders.
dot.size = Math.Int(screen.h / 110) + 2;
dot.pitch = dot.size * 2;
dot.max = Math.Int(screen.w * 0.6 / dot.pitch);
dot.image = Image("rule.png").Scale(dot.size, dot.size);
dot.y = text.y + text.line + Math.Int((text.line - dot.size) / 2);

# Returns a sprite with the text centered at row y, or NULL if nothing rendered.
fun CentredText(str, r, g, b, y) {
    if (!str)
        return NULL;
    img = Image.Text(str, r, g, b);
    if (!img || img.GetWidth() < 1)
        return NULL;
    spr = Sprite(img);
    spr.SetPosition(screen.x + Math.Int((screen.w - img.GetWidth()) / 2), y, 20);
    return spr;
}

fun ShowBullets(count) {
    if (count > dot.max)
        count = dot.max;
    for (i = 0; i < bullets.count; i++)
        bullets.sprite[i] = NULL;
    x = screen.x + Math.Int((screen.w - (count * dot.pitch - dot.size)) / 2);
    for (i = 0; i < count; i++) {
        bullets.sprite[i] = Sprite(dot.image);
        bullets.sprite[i].SetPosition(x + i * dot.pitch, dot.y, 20);
    }
    bullets.count = count;
}

fun ClearPrompt() {
    prompt.sprite = NULL;
    answer.sprite = NULL;
    ShowBullets(0);
}

# Passphrase prompt (LUKS unlock): light prompt text, signal-red bullets.
fun DisplayPasswordCallback(prompt_text, bullet_count) {
    ClearPrompt();
    if (!prompt_text)
        prompt_text = "Enter passphrase";
    prompt.sprite = CentredText(prompt_text, 0.957, 0.961, 0.965, text.y);
    ShowBullets(bullet_count);
}
Plymouth.SetDisplayPasswordFunction(DisplayPasswordCallback);

fun DisplayQuestionCallback(prompt_text, entry) {
    ClearPrompt();
    prompt.sprite = CentredText(prompt_text, 0.957, 0.961, 0.965, text.y);
    answer.sprite = CentredText(entry, 0.957, 0.961, 0.965, text.y + text.line);
}
Plymouth.SetDisplayQuestionFunction(DisplayQuestionCallback);

fun DisplayNormalCallback() {
    ClearPrompt();
}
Plymouth.SetDisplayNormalFunction(DisplayNormalCallback);

# Status messages (fsck, etc.) sit low on the screen in a muted grey.
fun MessageCallback(str) {
    message.sprite = NULL;
    message.sprite = CentredText(str, 0.54, 0.55, 0.57, screen.y + Math.Int(screen.h * 0.9));
}
Plymouth.SetMessageFunction(MessageCallback);

fun QuitCallback() {
    ClearPrompt();
    message.sprite = NULL;
}
Plymouth.SetQuitFunction(QuitCallback);
