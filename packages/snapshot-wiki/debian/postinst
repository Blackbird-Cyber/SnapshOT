#!/bin/sh
set -e
# Point the diverted helpers.rc at SnapshOT's copy (see preinst).
DIV=/etc/xdg/xfce4/helpers.rc
OURS=/usr/share/snapshot-wiki/xfce4-helpers.rc
case "$1" in
    configure)
        mkdir -p "$(dirname "$DIV")"
        if [ ! -e "$DIV" ] || [ -L "$DIV" ]; then
            ln -sfn "$OURS" "$DIV"
        fi
        ;;
esac
#DEBHELPER#
exit 0
