[Desktop Entry]
Type=Application
Version=1.0
Name=nmap ICS scripts
Comment=nmap NSE help for ICS/OT protocols
Exec=/usr/share/snapshot-menu/exec-in-shell "nmap --script-help 'modbus*,s7*,enip*,bacnet*,dnp3*,omron*,fox*,pcworx*,iec*'"
Terminal=true
StartupNotify=false
Icon=nmap
Categories=X-SnapshOT-Recon;X-SnapshOT-Protocols;
