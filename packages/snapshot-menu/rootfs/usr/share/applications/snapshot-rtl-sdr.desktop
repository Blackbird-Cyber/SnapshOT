[Desktop Entry]
Type=Application
Version=1.0
Name=rtl-sdr (dongle check)
Comment=Find an RTL-SDR dongle and read its tuner and EEPROM identity (read-only)
Exec=/usr/share/snapshot-menu/exec-in-shell "rtl_eeprom"
Terminal=true
StartupNotify=false
Icon=network-wireless
Categories=X-SnapshOT-Wireless;
