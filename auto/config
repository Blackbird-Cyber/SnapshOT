#!/bin/sh
# SnapshOT live-build configuration.
# Runs `lb config` with snapshot-pinned mirrors and the SnapshOT ISO identity.
# Reproducibility depends on the pin in config/snapshot.env plus SOURCE_DATE_EPOCH,
# which scripts/build.sh exports before calling `lb build`.
#
# SNAPSHOT_ARCH selects the target: amd64 (default; BIOS + UEFI) or arm64 (UEFI
# only; for arm64 VMs such as UTM/Parallels/VMware Fusion on Apple Silicon, and
# UEFI arm64 hardware). Build on a host of the same architecture;
# docker/build-in-docker.sh picks the matching container platform.
set -e

# Load the reproducibility pin.
. "$(dirname "$0")/../config/snapshot.env"

ARCH="${SNAPSHOT_ARCH:-amd64}"
case "$ARCH" in
	amd64) BOOTLOADERS="grub-efi grub-pc" ;;
	arm64) BOOTLOADERS="grub-efi" ;;
	*) echo "auto/config: unsupported SNAPSHOT_ARCH='$ARCH' (use amd64 or arm64)" >&2; exit 1 ;;
esac

# --uefi-secure-boot enable: the ISO boots through shim and signed GRUB, and the
# build fails if they are missing. shim-signed and grub-efi-<arch>-signed are in
# the installer package list (the installed system needs them). In the default
# "auto" mode live-build's binary stage records them as its own temporary
# packages anyway and purges them from the build chroot (after the squashfs is
# made, so the image keeps them), with a warning about protected packages.
lb config noauto \
	--mode debian \
	--distribution "${SNAPSHOT_DIST}" \
	--archive-areas "main contrib non-free non-free-firmware" \
	--parent-archive-areas "main contrib non-free non-free-firmware" \
	--mirror-bootstrap "${SNAPSHOT_MIRROR_DEBIAN}" \
	--mirror-chroot "${SNAPSHOT_MIRROR_DEBIAN}" \
	--mirror-chroot-security "${SNAPSHOT_MIRROR_SECURITY}" \
	--mirror-binary "${SNAPSHOT_MIRROR_DEBIAN}" \
	--mirror-binary-security "${SNAPSHOT_MIRROR_SECURITY}" \
	--security true \
	--updates true \
	--backports false \
	--apt-indices false \
	--apt-recommends false \
	--apt-options "--yes -o Acquire::Retries=5 -o Acquire::Check-Valid-Until=false -o Acquire::AllowInsecureRepositories=false" \
	--binary-images iso-hybrid \
	--bootloaders "${BOOTLOADERS}" \
	--uefi-secure-boot enable \
	--debian-installer none \
	--memtest none \
	--firmware-chroot true \
	--firmware-binary true \
	--architectures "${ARCH}" \
	--linux-flavours "${ARCH}" \
	--iso-application "SnapshOT" \
	--image-name "snapshot" \
	--iso-volume "SnapshOT ${SNAPSHOT_DIST} ${ARCH}" \
	--iso-preparer "SnapshOT build; https://snapshot.debian.org/archive/debian/${SNAPSHOT_DEBIAN_PIN}/" \
	--iso-publisher "Blackbird Cyber" \
	--bootappend-live "boot=live components quiet splash username=snapshot hostname=snapshot noeject" \
	"${@}"
