# live-build working + output
.build/
build/
config/binary
config/bootstrap
config/chroot
config/common
config/source
chroot/
binary/
cache/
*.iso
*.img
*.log

# built branding packages
config/packages.chroot/*.deb
packages/*.deb
packages/*.buildinfo
packages/*.changes
packages/*/debian/.debhelper/
packages/*/debian/files
packages/*/debian/snapshot-*/
packages/*/debian/calamares-settings-snapshot/
packages/*/obj-*/

# fetched vendor artifacts (reproduced from vendor/*.in + *.lock, not committed).
# Per-tool requirements.txt (hash-pinned locks) ARE committed.
vendor/python/*/wheelhouse/
vendor/src/**
!vendor/src/.gitkeep

# staged copies
config/includes.chroot/usr/local/share/snapshot/vendor/
config/includes.chroot/etc/snapshot-release

# private / unfree ingest (never committed)
private/

# macOS
.DS_Store

# release artifacts (built ISOs, checksums, split parts)
SHA256SUMS
*.sha256
*.iso.part-*

# python bytecode
__pycache__/
*.pyc
