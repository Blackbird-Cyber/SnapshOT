# Discovery: passive-first, careful active. (zeek is not in Debian; it is built
# in the source layer. GRASSMARLIN and Redpoint NSE are also source layer.
# ntopng is not in trixie: upstream apt repo only, not pinned here.)
wireshark
tshark
termshark
tcpdump
p0f
nmap
netdiscover
arp-scan
fping
nbtscan
# avahi-browse needs avahi-daemon, which hook 0300 masks (quiet on the wire), so
# the menu's mDNS entry listens passively with tshark instead (snapshot-menu's
# mdns-listen helper). Kept for a deliberate avahi-browse after the operator
# unmasks and starts the daemon.
avahi-utils
