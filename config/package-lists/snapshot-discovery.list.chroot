# Discovery: passive-first, careful active. zeek and GRASSMARLIN are not in
# Debian; both are disabled placeholders in the vendor layer (vendor/sources.lock).
# The Redpoint NSE scripts are vendored there. ntopng is not in trixie (upstream
# apt repo only) and is not pinned here.
wireshark
tshark
termshark
tcpdump
p0f
nmap
netdiscover
arp-scan
fping
nbtscan
# avahi-browse needs avahi-daemon, which hook 0300 masks (quiet on the wire), so
# the menu's mDNS entry listens passively with tshark instead (snapshot-menu's
# mdns-listen helper). Kept for a deliberate avahi-browse after the operator
# unmasks and starts the daemon.
avahi-utils
