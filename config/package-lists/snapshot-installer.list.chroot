# Offline installer (Calamares) with LUKS2 + LVM, plus the bootloader packages
# Calamares installs onto the target disk. amd64 gets BIOS + UEFI GRUB; arm64 is
# UEFI only.
calamares
# Calamares checks the new user's password with libpwquality (users.conf), which
# loads the cracklib dictionary. Only cracklib-runtime ships it (as a recommend,
# and recommends are off); without it every password fails with "error loading
# dictionary".
cracklib-runtime
# The install slideshow (branding show.qml) is QML and imports QtQuick, and
# Calamares' slideshow components import QtQuick.Window. The calamares package
# depends on neither QML module, so without them the slideshow area is black.
qml6-module-qtquick
qml6-module-qtquick-window
squashfs-tools
cryptsetup
cryptsetup-initramfs
lvm2
dosfstools
e2fsprogs
gdisk
parted
#if ARCHITECTURES amd64
grub-efi-amd64
grub-pc-bin
#endif
#if ARCHITECTURES arm64
grub-efi-arm64
#endif
