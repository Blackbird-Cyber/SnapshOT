# SnapshOT reproducibility pin.
# Every build resolves apt against ONE snapshot.debian.org timestamp, and stamps
# files with the matching SOURCE_DATE_EPOCH. Two builds of the same release from
# the same pin produce the same ISO.
#
# TODO(release): pick a real snapshot timestamp and its matching epoch before the
# first release build. Find valid timestamps at https://snapshot.debian.org/archive/debian/
# The value below is a placeholder and MUST be updated.
#
# Format: YYYYMMDDTHHMMSSZ (UTC, as snapshot.debian.org uses in its archive paths).
SNAPSHOT_DEBIAN_PIN="20260901T000000Z"

# SOURCE_DATE_EPOCH must equal the snapshot instant above, as a Unix timestamp.
# Derive it on the build host with:  date -u -d '2026-09-01 00:00:00' +%s
SNAPSHOT_SOURCE_DATE_EPOCH="1756684800"

# Debian release to track.
SNAPSHOT_DIST="trixie"

# Snapshot mirror bases (do not edit unless Debian moves the service).
SNAPSHOT_MIRROR_DEBIAN="https://snapshot.debian.org/archive/debian/${SNAPSHOT_DEBIAN_PIN}/"
SNAPSHOT_MIRROR_SECURITY="https://snapshot.debian.org/archive/debian-security/${SNAPSHOT_DEBIAN_PIN}/"
