#!/bin/sh
# Record what went into this image, for the release manifest and evidence trail.
set -e
OUT=/usr/share/snapshot/reference/BUILD-MANIFEST.txt
mkdir -p "$(dirname "$OUT")"
{
    [ -f /etc/snapshot-release ] && . /etc/snapshot-release
    echo "SnapshOT build manifest"
    echo "version: ${SNAPSHOT_VERSION:-unknown} ${SNAPSHOT_ARCH:-unknown} git:${SNAPSHOT_GIT:-unknown}"
    echo "debian_snapshot: ${SNAPSHOT_DEBIAN_PIN:-unknown}"
    echo "source_date_epoch: ${SOURCE_DATE_EPOCH:-unknown}"
    echo "kernel: $(ls /boot/vmlinuz-* 2>/dev/null | sed 's#.*/vmlinuz-##' | tr '\n' ' ')"
    echo
    echo "== dpkg packages =="
    dpkg-query -W -f='${Package} ${Version}\n' 2>/dev/null | sort
    echo
    echo "== vendored runtimes & tools (/opt/snapshot) =="
    if ls /usr/share/snapshot/vendor/*.manifest >/dev/null 2>&1; then
        for m in /usr/share/snapshot/vendor/*.manifest; do
            echo "--- $(basename "$m" .manifest) ---"
            cat "$m"
            echo
        done
        echo "== /opt/snapshot/bin =="
        ls -1 /opt/snapshot/bin 2>/dev/null || echo "(none)"
    else
        echo "(no vendor layer in this image)"
    fi
} > "$OUT"
echo "SnapshOT: wrote $OUT"
