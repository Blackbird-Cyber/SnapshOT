#!/bin/sh
# Install vendored, non-apt tools staged under /usr/local/share/snapshot/src.
# Each subdir is a prepared artifact; missing ones are skipped so partial vendor
# sets still build. Reference data lands under /usr/share/snapshot/reference.
set -e
SRC=/usr/local/share/snapshot/src
[ -d "$SRC" ] || { echo "SnapshOT: no source tools staged; skipping."; exit 0; }

install_dir() { # name -> /opt/snapshot/<name>, with a /usr/local/bin launcher if present
    n="$1"
    [ -d "$SRC/$n" ] || return 0
    mkdir -p "/opt/snapshot/$n"
    cp -a "$SRC/$n/." "/opt/snapshot/$n/"
    echo "SnapshOT: installed $n -> /opt/snapshot/$n"
}

for n in zeek ghidra grassmarlin firmware-mod-kit plcscan s7scan; do
    install_dir "$n"
done

# Redpoint NSE scripts drop straight into nmap's script dir if staged.
if [ -d "$SRC/redpoint-nse" ]; then
    mkdir -p /usr/share/nmap/scripts
    cp -a "$SRC/redpoint-nse/." /usr/share/nmap/scripts/ 2>/dev/null || true
    command -v nmap >/dev/null 2>&1 && nmap --script-updatedb || true
fi

# ICSNPP Zeek parsers, if both zeek and the parsers are staged.
if [ -d "$SRC/icsnpp" ] && [ -d /opt/snapshot/zeek ]; then
    mkdir -p /opt/snapshot/zeek/share/zeek/site/icsnpp
    cp -a "$SRC/icsnpp/." /opt/snapshot/zeek/share/zeek/site/icsnpp/ 2>/dev/null || true
fi

# Exploit-DB reference data stays as read-only reference.
if [ -d "$SRC/exploitdb" ]; then
    mkdir -p /usr/share/snapshot/reference/exploitdb
    cp -a "$SRC/exploitdb/." /usr/share/snapshot/reference/exploitdb/
fi

rm -rf "$SRC"
