#!/bin/sh
# Install the SnapshOT ICS Python libraries from the pinned, offline wheelhouse
# into a dedicated venv at /opt/snapshot/venv. No network is used.
set -e
STAGE=/usr/local/share/snapshot
WH="$STAGE/wheelhouse"
REQ="$STAGE/requirements.txt"
VENV=/opt/snapshot/venv

if [ ! -d "$WH" ] || [ ! -f "$REQ" ]; then
    echo "SnapshOT: no wheelhouse staged; skipping ICS Python libraries."
    exit 0
fi
if grep -q 'PLACEHOLDER-UNPINNED' "$REQ"; then
    echo "SnapshOT: requirements.txt is the unpinned placeholder. Run scripts/fetch-vendor.sh first." >&2
    exit 1
fi

python3 -m venv "$VENV"
"$VENV/bin/pip" install --no-index --no-cache-dir --require-hashes \
    --find-links "$WH" -r "$REQ"

# Expose the venv on PATH for interactive sessions.
cat > /etc/profile.d/snapshot-venv.sh <<'PROF'
# SnapshOT ICS Python tools venv
case ":$PATH:" in
  *":/opt/snapshot/venv/bin:"*) ;;
  *) PATH="/opt/snapshot/venv/bin:$PATH" ;;
esac
export PATH
PROF

rm -rf "$WH" "$REQ"
echo "SnapshOT: ICS Python libraries installed into $VENV."
